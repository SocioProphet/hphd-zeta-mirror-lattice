{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.socioprophet.ai/hphd/prime_phase_harness.schema.json",
  "title": "Prime Phase Ranking Harness Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "claim_boundary",
    "code_revision",
    "pre_registration",
    "baselines",
    "windows",
    "aggregates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{2,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pre_registered",
        "executed",
        "invalidated",
        "promoted_candidate_signal",
        "falsified"
      ]
    },
    "claim_boundary": {
      "type": "string",
      "const": "computational_experiment_only_not_proof"
    },
    "code_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "sha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "pre_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_policy",
        "magnitude_bands",
        "wheel_policy",
        "survivor_filters",
        "ranking_policies",
        "ranking_direction",
        "audit_method",
        "random_seed_ledger",
        "success_metrics"
      ],
      "properties": {
        "input_policy": {
          "type": "string",
          "minLength": 1
        },
        "magnitude_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min_p", "max_p"],
            "properties": {
              "min_p": {"type": "integer", "minimum": 2},
              "max_p": {"type": "integer", "minimum": 3}
            }
          }
        },
        "wheel_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id"],
          "properties": {
            "policy_id": {
              "type": "string",
              "enum": ["fixed_30", "fixed_210", "primorial_B"]
            },
            "M": {
              "type": "integer",
              "minimum": 2
            },
            "B": {
              "type": "integer",
              "minimum": 2
            },
            "residue_traversal": {
              "type": "string",
              "enum": ["numeric", "crt", "multiplicative_order"]
            }
          }
        },
        "survivor_filters": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "ranking_policies": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "ranking_direction": {
          "type": "string",
          "enum": ["descending_score", "ascending_score"]
        },
        "audit_method": {
          "type": "string",
          "minLength": 1
        },
        "random_seed_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy", "seed"],
            "properties": {
              "policy": {"type": "string", "minLength": 1},
              "seed": {"type": "integer"}
            }
          }
        },
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 6,
      "contains": {"const": "ascending_order"},
      "items": {
        "type": "string",
        "enum": [
          "ascending_order",
          "random_order_fixed_seed",
          "wheel_channel_order",
          "distance_from_p",
          "local_density_prior",
          "phase_gate_order",
          "log_space_phase_gate_order",
          "crt_channel_order",
          "multiplicative_order_channel"
        ]
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "p",
          "q",
          "M",
          "wheel_policy_id",
          "survivor_count",
          "rank_gate",
          "rank_ascending",
          "rank_random_mean",
          "rank_wheel",
          "rank_distance",
          "rho_gate",
          "rho_ascending",
          "rho_random_mean",
          "rho_wheel",
          "rho_distance",
          "delta_rank_vs_ascending",
          "delta_rho_vs_ascending",
          "audit_method"
        ],
        "properties": {
          "p": {"type": "integer", "minimum": 2},
          "q": {"type": "integer", "minimum": 3},
          "M": {"type": "integer", "minimum": 2},
          "wheel_policy_id": {"type": "string", "minLength": 1},
          "survivor_count": {"type": "integer", "minimum": 1},
          "rank_gate": {"type": "integer", "minimum": 1},
          "rank_ascending": {"type": "integer", "minimum": 1},
          "rank_random_mean": {"type": "number", "minimum": 1},
          "rank_wheel": {"type": "integer", "minimum": 1},
          "rank_distance": {"type": "integer", "minimum": 1},
          "rho_gate": {"type": "number", "minimum": 0, "maximum": 1},
          "rho_ascending": {"type": "number", "minimum": 0, "maximum": 1},
          "rho_random_mean": {"type": "number", "minimum": 0, "maximum": 1},
          "rho_wheel": {"type": "number", "minimum": 0, "maximum": 1},
          "rho_distance": {"type": "number", "minimum": 0, "maximum": 1},
          "delta_rank_vs_ascending": {"type": "number"},
          "delta_rho_vs_ascending": {"type": "number"},
          "audit_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primary_metric", "beats_ascending_order", "magnitude_band_stability"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "beats_ascending_order": {"type": "boolean"},
        "magnitude_band_stability": {
          "type": "string",
          "enum": ["not_evaluated", "stable", "unstable", "insufficient_data"]
        }
      }
    }
  }
}
